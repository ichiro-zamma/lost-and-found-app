//8テーブルの設計図
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

//Prisma Clientを生成するための設定
generator client {
  provider = "prisma-client"
  //生成されたPrisma Clientをどこに置くか
  output   = "../src/generated/prisma"
}

//このPrisma Schemaが接続するDBはPostgreSQLです
//なぜPrismaを使っている？
//PostgreSQLを直接SQLで操作することもできますが、Prismaを使うことでTypeScriptから型安全にDB操作ができ、
//テーブル間のリレーションもコード上で扱いやすくなるためです。
datasource db {
  provider = "postgresql"
}

//値の範囲チェックをPrismaの標準機能(enum)で型安全に実装するため
//なぜenumにしましたか？
//RoleやItemStatusのように取り得る値が決まっているものなので、
//Prismaのenumを利用して値を限定し、型安全に扱えるようにしました。
//ユーザーの役割として使用できる値を限定している
enum Role {
  USER  // 一般ユーザー(落とした人/拾った人兼用)
  ADMIN // 施設管理者
}

//落とし物・拾得物の現在の状態
enum ItemStatus {
  UNMATCHED  // 未マッチング
  RETURNED   // 返却済み
}

//PostgreSQLのusersテーブルに対応するPrismaのモデル
//idプログラム上でのフィールド名  Int整数型　 @id主キー   @default(autoincrement())自動的に番号を振る  　
//@map("user_id")DB上のuser_idという名前にする
//なぜPrismaとDBで名前を変えている？
//idの方がPrismaコードでは扱いやすい
//DBでは「何のIDなのか」が名前だけで分かるようにしたい
model User {
  id           Int       @id @default(autoincrement()) @map("user_id")
  name         String    @db.VarChar(50) //最大50文字
  email        String    @unique @db.VarChar(255)//同じメールアドレスを複数ユーザーに登録できない 最大255文字
  password     String    @db.VarChar(255) //ハッシュ化されたパスワードを保存するカラム
  role         Role      @default(USER)　　//型 → Role enum  //初期値 → USER
  facilityId   Int?      @map("facility_id") //Userが所属する施設のID
  facility     Facility? @relation(fields: [facilityId], references: [id])　//そのIDに対応する「施設」  @relation＝「このIDと、この施設を関連付けます」
  createdAt    DateTime  @default(now()) @map("created_at")　//自動的に登録日時がDBに記録
  //users.createdAtは、現時点では画面上で利用していませんが、将来的な管理者向けの利用者一覧機能などに備えて、他のテーブルと統一的に記録するようにしています
  
  //このユーザーが登録した落とし物・拾得物（複数）
  lostItems  LostItem[]
  foundItems FoundItem[]

//Prismaのモデル名(model User)は単数形・パスカルケースにする
//DBのテーブル名(@@map("users"))は複数形・スネークケースにする
//model UserはPrisma側で使用するモデル名で、@@map("users")によって、実際のPostgreSQLではusersというテーブル名に対応させています。
//Prisma側とDB側で、それぞれ分かりやすい命名規則を使うため
 @@map("users")

 //@map 1つのカラムの名前を変更  @@map テーブルそのものの名前を変更
}

//拾得物を預かる施設
model Facility {
  id           Int     @id @default(autoincrement()) @map("facility_id")// 施設ID：主キー・自動採番・DBではfacility_id
  facilityName String  @map("facility_name") @db.VarChar(100)// 施設名：最大100文字・DBではfacility_name
  address      String @db.VarChar(200)// 住所：最大200文字

  users      User[]　　// この施設に所属するユーザー：1つの施設に複数人所属できる
  foundItems FoundItem[]　// この施設に預けられている拾得物：1つの施設で複数管理できる

  @@map("facilities")　// PrismaのFacilityモデルをDBのfacilitiesテーブルに対応させる
}
//施設は登録するところを作っていない　　seedで初期値を決めている

// 落とし物・拾得物が発生した「場所」を管理する
model Location {
  id           Int    @id @default(autoincrement()) @map("location_id")
  locationName String @unique @map("location_name") @db.VarChar(50)

  lostItems  LostItem[]
  // ↑ この場所で発生した落とし物
  //  1つの場所に複数のLostItemを関連付けられる
  foundItems FoundItem[]
  // ↑ この場所で発生した拾得物
  @@map("locations")
    // ↑ DBではlocationsというテーブル名にする
}

// 色を管理するテーブル
model Color {
  id        Int    @id @default(autoincrement()) @map("color_id")
  // ↑ 色ID：主キー・自動採番
  colorName String @unique @map("color_name") @db.VarChar(20)
  // ↑ 色の名前：文字列・最大20文字
  //   @unique：同じ色を重複登録できない

  lostItems  LostItem[]
  // ↑ この色の落とし物
  foundItems FoundItem[]
  // ↑ この色の拾得物

  @@map("colors")
  // ↑ DBではcolorsというテーブル名にする
}

// 落とし物・拾得物の種類を管理するテーブル
model Category {
  id           Int    @id @default(autoincrement()) @map("category_id")
  categoryName String @unique @map("category_name") @db.VarChar(30)

  lostItems  LostItem[]
  // ↑ この種類の落とし物
  foundItems FoundItem[]
  // ↑ この種類の拾得物

  @@map("categories")
  // ↑ DBではcategoriesというテーブル名にする
}

// 落とした物を管理するテーブル
model LostItem {
  id             Int        @id @default(autoincrement()) @map("lost_item_id")
  // ↑ 落とし物ID：主キー・自動採番
  userId         Int        @map("user_id")
   // ↑ 登録したユーザーのID
  user           User       @relation(fields: [userId], references: [id])
  // ↑ userIdを使ってUserテーブルと関連付ける
  //   fields：[LostItem側のuserId]
  //   references：[User側のid]

  categoryId     Int        @map("category_id")
   // ↑ 落とし物の種類ID
  category       Category   @relation(fields: [categoryId], references: [id])
  // ↑ categoryIdを使ってCategoryテーブルと関連付ける
  colorId        Int        @map("color_id")
  // ↑ 落とし物の色ID
  color          Color      @relation(fields: [colorId], references: [id])
  // ↑ colorIdを使ってColorテーブルと関連付ける
  locationId     Int        @map("location_id")
   // ↑ 落とした場所のID
  location       Location   @relation(fields: [locationId], references: [id])
  // ↑ locationIdを使ってLocationテーブルと関連付ける
  locationDetail String?    @map("location_detail") @db.VarChar(100)
  // ↑ 詳細な場所//   ?：入力しなくてもOK　//   最大100文字
  lostAt         DateTime   @map("lost_at")
  // ↑ 実際に落とした日時　//   DBではlost_at
  secretInfo     String     @map("secret_info") @db.VarChar(200)
  // ↑ 本人確認用の秘密情報　　 //   最大200文字
  imageUrl       String?    @map("image_url") @db.VarChar(255)
  // ↑ 画像URL　//   ?：画像なしでもOK
  status         ItemStatus @default(UNMATCHED)
  // ↑ 落とし物の現在の状態
  //   UNMATCHED または RETURNED
  //   初期状態はUNMATCHED
  createdAt      DateTime   @default(now()) @map("created_at")
  // ↑ この落とし物をアプリに登録した日時
  //   登録時に自動設定

  match Match?
   // ↑ この落とし物に対応するMatch
  //   ?：まだマッチしていない場合もある
 //「Match（マッチ）」＝「落とし物と拾得物が同じものだと紐づいた状態」

  @@map("lost_items")

}

// 拾った物を管理するテーブル
model FoundItem {
  id             Int        @id @default(autoincrement()) @map("found_item_id")
  // ↑ 拾得物ID：主キー・自動採番
  userId         Int        @map("user_id")
   // ↑ 登録したユーザーのID
  user           User       @relation(fields: [userId], references: [id])
  // ↑ userIdを使ってUserと関連付ける
  categoryId     Int        @map("category_id")
  // ↑ 拾得物の種類ID
  category       Category   @relation(fields: [categoryId], references: [id])
   // ↑ categoryIdを使ってCategoryと関連付ける
  colorId        Int        @map("color_id")
  // ↑ 拾得物の色ID
  color          Color      @relation(fields: [colorId], references: [id])
  // ↑ colorIdを使ってColorと関連付ける
  locationId     Int        @map("location_id")
   // ↑ 拾った場所のID
  location       Location   @relation(fields: [locationId], references: [id])
  // ↑ locationIdを使ってLocationと関連付ける
  locationDetail String?    @map("location_detail") @db.VarChar(100)
  // ↑ 詳細な場所：任意・最大100文字
  foundAt        DateTime   @map("found_at")
  // ↑ 実際に拾った日時
  imageUrl       String?    @map("image_url") @db.VarChar(255)
  // ↑ 画像URL：任意
  facilityId     Int?       @map("facility_id")
  // ↑ 拾得物を預けた施設のID
  //   ?：まだ施設に預けていない場合はNULL
  facility       Facility?  @relation(fields: [facilityId], references: [id])
  // ↑ facilityIdを使ってFacilityと関連付ける
  status         ItemStatus @default(UNMATCHED)
  // ↑ 拾得物の現在の状態
  //   初期状態はUNMATCHED
  createdAt      DateTime   @default(now()) @map("created_at")
  // ↑ 拾得物をアプリに登録した日時

  match Match?
   // ↑ この拾得物に対応するMatch
  //   まだマッチしていない場合もある

  @@map("found_items")
  // ↑ DBではfound_itemsというテーブル名にする
}



// 落とし物と拾得物のマッチング結果を管理するテーブル
model Match {
  id          Int       @id @default(autoincrement()) @map("match_id")
  lostItemId  Int       @unique @map("lost_item_id")
  lostItem    LostItem  @relation(fields: [lostItemId], references: [id])
  foundItemId Int       @unique @map("found_item_id")
  foundItem   FoundItem @relation(fields: [foundItemId], references: [id])
  matchedAt   DateTime  @default(now()) @map("matched_at")
   // ↑ マッチングした日時
  //   登録時に自動設定

  @@map("matches")
}