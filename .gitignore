# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma


.agents/
.claude/
.windsurf/
skills-lock.json

# .agents/	AIコーディングエージェント向けの補助ファイル置き場	このアプリの動作には一切関係ない、Prisma CLIが自動生成した付随物
# .claude/	Claude Code向けのスキル定義ファイル置き場	同上。特定のAIツールの設定であり、アプリのソースコードではない
# .windsurf/	Windsurf(別のAIコーディングツール)向けの設定ファイル置き場	同上
# skills-lock.json	上記スキルファイル群のバージョン管理用ロックファイル	上記3つのフォルダに対応するロックファイルなので、フォルダ自体を除外するなら一緒に除外するのが自然

public/uploads/*
!public/uploads/.gitkeep

# 画像を全部GitHubに入れてしまうと、
# GitHubの容量を使う
# 画像が増えるたびにGitの管理対象が増える
# ユーザーがアップロードした画像までGitHubに入ってしまう
# という問題がある
# だから、
# 画像 → GitHubに入れない
# フォルダ → GitHubには残す
# という設定にしています。
# つまり、この2行は、
# 「uploadsフォルダは必要だから残す。でも中のアップロード画像はGit管理しない」